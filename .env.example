DATABASE_URL="file:./dev.db"

# PayPal — récupérez vos clés sur developer.paypal.com
# Sandbox pour les tests, Live pour la production
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=votre_client_id_paypal
PAYPAL_CLIENT_SECRET=votre_client_secret_paypal
NEXT_PUBLIC_PAYPAL_CLIENT_ID=votre_client_id_paypal

# Resend — clé API sur resend.com
RESEND_API_KEY=re_votre_cle_ici

# Admin
ADMIN_EMAIL=votre@email.com
ADMIN_PASSWORD=votre_mot_de_passe_admin

# App
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Cookie secret (générez une chaîne aléatoire 32+ caractères)
JWT_SECRET=une-chaine-secrete-tres-longue-et-aleatoire
